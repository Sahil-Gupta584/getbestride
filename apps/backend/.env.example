PORT=4000

# --- Solari ---
# Fare scraping drives a real browser on this profile. The profile holds the
# logged-in sessions for Uber, Rapido and Ola, so no per-provider cookies or API
# keys are needed here.
SOLARI_API_KEY=your_solari_api_key
SOLARI_PROFILE_ID=your_solari_profile_id

# --- Shared browser registry (Upstash Redis) ---
# Coordinates the single shared Solari browser across concurrent requests and
# across backend instances. Required: the backend fails fast at boot without it.
# console.upstash.com -> database -> Connect -> REST
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
