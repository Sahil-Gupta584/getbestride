{
  "name": "driz",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e .env vite dev ",
    "build": "vite build",
    "start": "node --import ./.output/server/instrument.server.mjs .output/server/index.mjs",
    "preview": "vite preview",
    "generate-routes": "tsr generate",
    "post-cta-init": "npx -y create-db@latest --user-agent tanstack/tsrouter",
    "db:generate": "dotenv -e .env -- drizzle-kit generate",
    "db:migrate": "dotenv -e .env -- drizzle-kit migrate",
    "db:studio": "dotenv -e .env -- drizzle-kit studio",
    "lint": "eslint",
    "check": "prettier --check .",
    "format": "prettier --write . && eslint --fix",
    "test": "vitest run"
  },
  "dependencies": {
    "@hookform/resolvers": "5.4.0",
    "@orpc/client": "^1.13.6",
    "@orpc/json-schema": "^1.13.6",
    "@orpc/openapi": "^1.13.6",
    "@orpc/server": "^1.13.6",
    "@orpc/tanstack-query": "^1.13.6",
    "@orpc/zod": "^1.13.6",
    "@paralleldrive/cuid2": "3.3.0",
    "@radix-ui/react-avatar": "1.2.6",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-separator": "1.1.15",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-tooltip": "1.2.16",
    "@repo/api": "*",
    "@sentry/tanstackstart-react": "^10.42.0",
    "@t3-oss/env-core": "^0.13.10",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-query": "latest",
    "@tanstack/react-query-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-router-ssr-query": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/router-plugin": "^1.132.0",
    "better-auth": "^1.5.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dodopayments": "2.44.0",
    "dotenv-cli": "^11.0.0",
    "drizzle-orm": "0.45.3",
    "lucide-react": "0.545.0",
    "nitro": "3.0.260903-beta",
    "pg": "8.23.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "7.79.0",
    "react-icons": "5.6.0",
    "resend": "6.13.0",
    "shadcn": "4.21.0",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/eslint-config": "latest",
    "@tanstack/router-cli": "^1.132.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.10.2",
    "@types/pg": "8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
