# Server
DATABASE_URL=postgresql://postgres.pabarkwegbrrfksntvss:PASSWORD@aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres?schema=public
VITE_BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=            # Generate: `npx -y @better-auth/cli secret`
RESEND_API_KEY=re_**

# ── Quotes backend (apps/backend) ────────────────────────────────────────────
# The browser calls the quotes API directly (POST {VITE_BACKEND_URL}/rpc),
# typed from `@repo/api`. No secret: quotes will become authed procedures.
VITE_BACKEND_URL=http://localhost:4000

# ── Google OAuth (optional) ──────────────────────────────────────────────────
# Leave both blank to hide the Google sign-in button.
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Set to any non-empty value when the credentials above are configured.
VITE_GOOGLE_AUTH_ENABLED=

# ── Address autocomplete ─────────────────────────────────────────────────────
# LocationIQ powers the pickup/drop inputs. Free tier is 5,000 requests/day at 2
# requests/second, and their terms require a visible link back to locationiq.com
# for commercial use (the UI renders one). Sign up at
# https://my.locationiq.com/register — the token is the `pk.…` part on its own,
# without the `locationiq:` prefix.
LOCATIONIQ_TOKEN=

# ── Sentry (optional) ────────────────────────────────────────────────────────
VITE_SENTRY_DSN=
VITE_SENTRY_ORG=
VITE_SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ── Dodo Payments (optional) ─────────────────────────────────────────────────
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
