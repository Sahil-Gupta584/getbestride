{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        "dist/**",
        ".output/**"
      ],
      "env": [
        "DATABASE_URL",
        "VITE_BETTER_AUTH_URL",
        "BETTER_AUTH_SECRET",
        "RESEND_API_KEY",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "LOCATIONIQ_TOKEN",
        "SENTRY_AUTH_TOKEN",
        "DODO_PAYMENTS_API_KEY",
        "DODO_PAYMENTS_WEBHOOK_KEY",
        "DODO_PAYMENTS_ENVIRONMENT",
        "VITE_BACKEND_URL",
        "VITE_SENTRY_DSN",
        "VITE_SENTRY_ORG",
        "VITE_SENTRY_PROJECT",
        "VITE_GOOGLE_AUTH_ENABLED"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "check-types": {
      "dependsOn": [
        "^check-types"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "generate-routes": {
      "cache": false
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    },
    "db:studio": {
      "cache": false,
      "persistent": true
    },
    "db:push": {
      "cache": false
    },
    "db:pull": {
      "cache": false
    }
  }
}